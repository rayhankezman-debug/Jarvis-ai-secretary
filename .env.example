# Telegram Bot
TELEGRAM_BOT_TOKEN= TELEGRAM_BOT_TOKEN

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_secretary

# Timezone
TIMEZONE=Asia/Jakarta

# Morning Brief (Phase 7)
MORNING_BRIEF_TIME=07:00
ENABLE_MORNING_BRIEF=true

# Application
APP_ENV=development
LOG_LEVEL=INFO
